{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EC2etVPCUniquementRegionParis",
      "Effect": "Allow",
      "Action": "ec2:*",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-west-3" } }
    },
    {
      "Sid": "S3ListerLesBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets", "s3:GetBucketLocation"],
      "Resource": "*"
    },
    {
      "Sid": "S3UniquementBucketsMediTrack",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::meditrack-*"
    },
    {
      "Sid": "CloudFront",
      "Effect": "Allow",
      "Action": "cloudfront:*",
      "Resource": "*"
    },
    {
      "Sid": "KMSPourChiffrementEBSViaEC2",
      "Effect": "Allow",
      "Action": ["kms:DescribeKey", "kms:CreateGrant", "kms:GenerateDataKeyWithoutPlaintext", "kms:Decrypt"],
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ec2.eu-west-3.amazonaws.com" } }
    }
  ]
}
